# ==============================================================================
# ZeroKey - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. User Session Data, Browser Profiles & Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
user_data/
user_data*/
temp_uploads/
uploads/
downloads/
browser_profiles/
chrome_profile/
storage_state.json
cookies*.json
session*.json
token.json
tokens.json
credentials.json
auth/
secrets/

# Playwright artifacts
.playwright/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# Certificates and keys
*.pem
*.key
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 3. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & distribution
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 5. Testing, Type Checking & Linting Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ------------------------------------------------------------------------------
# 6. Temporary, Backup & Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. IDE, Editor & OS Specific Files
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
